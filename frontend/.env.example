# Copy this file to .env.local for local development overrides (already gitignored via *.local).
# For production, set the equivalent variables in your hosting provider's dashboard (e.g. Render
# > your frontend static site > Environment) -- Vite bakes these in at BUILD time, so a rebuild
# is needed after changing them.

# Where the frontend should send API requests. Defaults to http://localhost:8000 if unset.
VITE_BACKEND_URL=http://localhost:8000

# From Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID, type "Web
# application"). The "Sign in with Google" button only renders once this is set.
VITE_GOOGLE_CLIENT_ID=
