# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/mrreadyprep_staging

# JWT
SECRET_KEY=your-secret-key-here-change-in-production

# SENDGRID (Extension 2)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# FIREBASE / GA4 (Extension 3)
VITE_GA_API_KEY=your_firebase_api_key
VITE_GA_AUTH_DOMAIN=mrreadyprep.firebaseapp.com
VITE_GA_PROJECT_ID=mrreadyprep
VITE_GA_STORAGE_BUCKET=mrreadyprep.appspot.com
VITE_GA_SENDER_ID=your_sender_id
VITE_GA_APP_ID=your_app_id
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GOOGLE SEARCH CONSOLE (Extension 4)
# Place gsc-credentials.json in backend/ directory

# SERPAPI (Extension 4)
SERPAPI_API_KEY=your_serpapi_key

# YOUTUBE (Extension 5)
# Place youtube_credentials.json in backend/ directory

# APP CONFIG
ENVIRONMENT=staging
DEBUG=true
CORS_ORIGIN=http://localhost:5173
API_URL=http://localhost:8000
