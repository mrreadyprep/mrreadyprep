# Copy this file to .env for local development (or set these as real environment variables
# in your hosting provider's dashboard, e.g. Render > your service > Environment).
# main.py does not currently auto-load a .env file, so for local dev either export these in your
# shell before running uvicorn, or add python-dotenv if you'd like .env auto-loading.

# Required in production. Any long random string works -- generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the app falls back to an insecure dev-only default (fine for localhost, NOT for a
# real deployment with real student accounts).
JWT_SECRET_KEY=

# Comma-separated list of extra frontend origins allowed to call this API (localhost:5173 is
# always allowed). Set this to your deployed frontend's URL once it has a real domain, e.g.:
#   CORS_ALLOWED_ORIGINS=https://mrreadyprep.onrender.com
CORS_ALLOWED_ORIGINS=

# This backend's own public URL, used to build absolute audio file links sent to the frontend.
# Defaults to http://localhost:8000 for local dev. In production set it to wherever this backend
# is actually reachable, e.g.:
#   BACKEND_PUBLIC_URL=https://mrreadyprep-api.onrender.com
BACKEND_PUBLIC_URL=

# From Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID, type "Web
# application"). Leave blank until Google Sign-In is wired up.
GOOGLE_CLIENT_ID=

# Where the frontend is reachable -- used to build the "reset your password" link sent by email.
# Defaults to http://localhost:5173 for local dev. In production set it to your real domain, e.g.:
#   FRONTEND_PUBLIC_URL=https://mrreadyprep.com
FRONTEND_PUBLIC_URL=

# From resend.com (free tier: 100 emails/day, no credit card required to start). Used for the
# forgot-password email and (later) email verification. Leave blank to run without real email
# delivery -- the reset link is then only printed to the server logs instead of emailed, which is
# fine for local testing but means real students on the live site won't receive anything.
RESEND_API_KEY=

# The "from" address Resend sends as. Until you verify your own domain in Resend, you must use
# their shared onboarding@resend.dev sender -- leave this at the default until you've done that.
RESEND_FROM_EMAIL=mrreadyprep <onboarding@resend.dev>
